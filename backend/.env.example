# ==========================================
# SCHOLARS GATE - Backend Environment Config
# ==========================================

# Application
PROJECT_NAME="SCHOLARS GATE"
PROJECT_DESCRIPTION="AI-Assisted Scholarship Management Platform for Scheduled Tribe (ST) Students"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=False
API_V1_STR="/api/v1"

# Database (PostgreSQL Async via asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/scholars_gate_db"
AUTO_CREATE_SCHEMA=False
RUN_MIGRATIONS_ON_STARTUP=False
SEED_DEFAULT_SCHEMES=False

# Supabase Auth & Storage
SUPABASE_URL="https://your-supabase-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"
SUPABASE_STORAGE_BUCKET="scholarship-documents"

# JWT Settings
JWT_ALGORITHM="HS256"
JWT_AUDIENCE="authenticated"

# Document AI & Engine Config
OCR_MODE="real" # Explicitly use "demo" only for non-production demonstrations
OCR_ENGINE="tesseract"
STORAGE_ROOT="./private_uploads"
MIN_CONFIDENCE_THRESHOLD=0.65
FUZZY_NAME_MATCH_THRESHOLD=80.0
FUZZY_INSTITUTION_MATCH_THRESHOLD=75.0
INCOME_DISCREPANCY_TOLERANCE_PERCENT=5.0

# CORS Settings (comma-separated URLs)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
